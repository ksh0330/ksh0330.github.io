@article{kim2025classification,
  title        = {Classification of Accident Risk Situations based on Vehicle Speed Estimation through Lane-Specific Coordinate Transformation},
  author       = {Kim, Seunghyun and Kang, Hanbin and Kang, Jonggyu and Bae, Changseok},
  journal      = {Journal of Korean Institute of Next Generation Computing},
  volume       = {21},
  number       = {1},
  pages        = {7--27},
  year         = {2025},
  month        = {february},
  abstract     = {This paper presents an accident-risk recognition model for intersections using CCTV footage. The model estimates vehicle speeds through lane-specific Bird's Eye View transformations and classifies traffic situations into safe, caution, and danger levels via an MLP-based classifier. Experiments on real and simulated videos demonstrate 89\% accuracy and 5 ms inference, validating its real-time applicability for accident risk detection.},
  preview      = {risk.gif},
  pdf          = {kim2025risk.pdf},
  selected     = {true},
  abbr         = {J. KINGPC.}
}

@inproceedings{kim2024drone,
  title        = {Real-Time Object Detection Service of Drone with Electro-Optics / Infra-Red Image Sensors},
  author       = {Kim, Seunghyun and Lee, Byungbog},
  booktitle    = {Proceedings of the 2024 Fall Conference of IEMEK},
  pages        = {300--302},
  year         = {2024},
  month        = {november},
  abstract     = {This study develops a real-time object detection service for drones integrating Electro-Optics (EO) and Infra-Red (IR) sensors over an n79 5G private network. The proposed system preprocesses EO/IR image data with slicing and padding techniques and optimizes the inference pipeline by minimizing batch size, enabling real-time object detection within 0.6 seconds in both day and night environments.},
  preview      = {drone.png},
  pdf          = {kim2024drone.pdf},
  selected     = {true},
  abbr         = {IEMEK}
}

